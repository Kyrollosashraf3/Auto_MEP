# ── Database ──────────────────────────────────────────────────────
# LOCAL development (SQLite) — use this by default, no extra setup needed
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./automep.db

# PRODUCTION (PostgreSQL) — switch to these when deploying
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mep

# ── App Settings ──────────────────────────────────────────────────
APP_NAME= "Auto_MEP"
APP_VERSION= "0.0.2"
APP_DESCRIPTION= "Auto MEP using AI"
DEBUG= True
HOST= "0.0.0.0"
PORT= 8000

FILE_ALLOWED_TYPES='["text/plain","application/pdf","text/csv","application/vnd.ms-excel","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]'
FILE_ALLOWED_SIZE= 40
TEMP_FOLDER_NAME= "automep_uploads"

MODELS_JSON_PATH="app/core/llm/models_registry.json"

# ── AI API Keys (optional for local use) ─────────────────────────
OPENAI_API_KEY="sk-proj-...."
GOOGLE_API_KEY="AQ....."
GROQ_API_KEY="gsk_..."
cooling_report_model="llama-3.1-8b-instant"
